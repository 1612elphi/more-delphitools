<script is:inline>
(function() {
  var bar = document.getElementById('exh-bar');
  if (!bar || bar.dataset.running) return;
  bar.dataset.running = '1';
  var w = 0;
  function fill() {
    w += 1 + Math.random() * 4;
    if (w > 100) w = 0;
    bar.style.width = Math.min(w, 100) + '%';
    setTimeout(fill, 60 + Math.random() * 80);
  }
  setTimeout(fill, 400);
})();
</script>

