<script is:inline>
  // Solari flip animation — extracted from Taxiway
  (function() {
    const board = document.getElementById('taxi-solari');
    if (!board || board.children.length > 0) return;
    const word = 'TAXIWAY';
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

    word.split('').forEach((target, i) => {
      const card = document.createElement('div');
      card.className = 'solari-char';

      const top = document.createElement('div');
      top.className = 'solari-half top';
      const topL = document.createElement('span');
      topL.className = 'solari-letter';
      topL.textContent = ' ';
      top.appendChild(topL);

      const bot = document.createElement('div');
      bot.className = 'solari-half bot';
      const botL = document.createElement('span');
      botL.className = 'solari-letter';
      botL.textContent = ' ';
      bot.appendChild(botL);

      card.appendChild(top);
      card.appendChild(bot);
      board.appendChild(card);

      const rolls = 5 + Math.floor(Math.random() * 5);
      let count = 0;

      setTimeout(() => {
        const tick = () => {
          const ch = count < rolls ? alphabet[Math.floor(Math.random() * 26)] : target;
          topL.textContent = ch;
          botL.textContent = ch;
          top.style.transition = 'transform 0.06s ease-in';
          top.style.transformOrigin = 'bottom';
          top.style.transform = 'perspective(400px) rotateX(-8deg)';
          setTimeout(() => {
            top.style.transition = 'transform 0.06s ease-out';
            top.style.transform = 'perspective(400px) rotateX(0deg)';
          }, 60);
          count++;
          if (count <= rolls) setTimeout(tick, 55 + count * 6);
        };
        tick();
      }, 200 + i * 140);
    });
  })();
</script>

