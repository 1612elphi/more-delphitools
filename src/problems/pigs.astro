<div class="pigs-takeover">
  <div class="stack">
    <div class="register"><span class="reg-label">T</span><span class="reg-val">0.0000</span></div>
    <div class="register"><span class="reg-label">Z</span><span class="reg-val">0.0000</span></div>
    <div class="register"><span class="reg-label">Y</span><span class="reg-val">0.0000</span></div>
    <div class="register active"><span class="reg-label">X</span><span class="reg-val" id="pigs-x">_</span></div>
  </div>
  <h1 class="pigs-title">PIGS</h1>
  <p class="pigs-sub">An RPN calculator for people who actually use calculators.</p>
  <p class="pigs-desc">Physical hardware. Orange keys. Four-register stack. Built for designers and printmakers with contempt for everything else on the market.</p>
  <a class="pigs-button" href="https://github.com/1612elphi/pigs">view on github</a>
</div>

<script is:inline>
(function() {
  var x = document.getElementById('pigs-x');
  if (!x || x.dataset.running) return;
  x.dataset.running = '1';
  var ops = ['3.1416','210','297','0.3528','72','2.8346','841','594','25.4','612','792','0.0139'];
  var i = 0;
  function cycle() {
    x.textContent = ops[i % ops.length];
    i++;
    setTimeout(cycle, 2000 + Math.random() * 1000);
  }
  setTimeout(cycle, 800);
})();
</script>

