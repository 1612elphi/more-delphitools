<script is:inline>
(function() {
  var grid = document.getElementById('nomi-cards');
  if (!grid || grid.dataset.filled) return;
  grid.dataset.filled = '1';
  var rules = [
    "Draw two cards.",
    "Skip your next turn.",
    "Reverse the turn order.",
    "All players must discard one card.",
    "Trade hands with another player.",
    "The next player draws three cards.",
    "All players pass their hands to the left.",
    "Challenge the previous card played.",
    "Copy the effect of the last card played.",
    "Cards can only be played with your non-dominant hand.",
    "Rip a card in half to veto any rule.",
    "Game is now a roguelike. Death resets all rules.",
    "Shuffle the rules mid-game. New order is retroactive.",
    "The game was rigged from the start. Always was.",
    "Every rule must be justified with a quote from a made-up ancient philosopher.",
    "This rule exists in a quantum state until observed.",
    "Rules can be traded like Pokemon cards.",
    "Time flows backwards every third turn.",
    "Winner is whoever holds the most pens when deck empties.",
    "Voting is done by rock-paper-scissors. Always."
  ];
  var fonts = ['sans-serif', 'serif', 'monospace'];
  var transforms = ['uppercase', 'lowercase', 'none'];
  var aligns = ['start', 'center', 'end'];
  for (var i = rules.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = rules[i]; rules[i] = rules[j]; rules[j] = t;
  }
  grid.querySelectorAll('.card').forEach(function(card, i) {
    card.textContent = rules[i % rules.length];
    card.style.fontFamily = fonts[Math.floor(Math.random() * 3)];
    card.style.textTransform = transforms[Math.floor(Math.random() * 3)];
    card.style.alignItems = aligns[Math.floor(Math.random() * 3)];
    card.style.justifyContent = aligns[Math.floor(Math.random() * 3)];
    card.style.fontStyle = Math.random() > 0.5 ? 'italic' : 'normal';
    card.style.letterSpacing = (Math.random() * 0.15).toFixed(2) + 'em';
  });
})();
</script>

