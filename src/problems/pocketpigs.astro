<script is:inline>
(function() {
  var x = document.getElementById('pp-x');
  if (!x || x.dataset.running) return;
  x.dataset.running = '1';
  var ops = ['25.4','72','297','0.3528','3.1416','841','2.8346','612','210','594'];
  var i = 0;
  function cycle() {
    x.textContent = ops[i % ops.length];
    i++;
    setTimeout(cycle, 1800 + Math.random() * 1200);
  }
  setTimeout(cycle, 600);
})();
</script>

